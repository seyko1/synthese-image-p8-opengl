#version 330
layout(location=0)in vec3 pos;layout(location=1)in vec3 normal;layout(location=2)in vec2 texCoord;uniform mat4 projection,modelView;uniform sampler2D tex;uniform vec2 pas;uniform float elapsed;out float lightIntensity;out float dc;vec2 offset[7]=vec2[7](vec2(pas.x,.0),vec2(pas.x,pas.y),vec2(.0,pas.y),vec2(-pas.x,.0),vec2(-pas.x,-pas.y),vec2(.0,-pas.y),vec2(.0,.0));float e(vec2 j){float k=distance(vec2(.5),j);float l=k/(1.42/2.);return texture(tex,vec2(1.,l)).r/4.;}vec3 f(vec3 m,vec3 o){return normalize(cross(m,o));}vec3 g(vec3 q,vec2 s,vec2 t){return q+vec3(t.x*2.,e(s),-(t.y*2.));}vec3 h(vec3 u,vec2 v){vec3 w=vec3(0);vec3 points[7];for(int z=0;z<7;++z){points[z]=g(u,v+offset[z],offset[z]);}for(int z=0;z<6;++z){vec3 B=points[6];vec3 C=points[z];vec3 D=points[(z+1)% 6];w+=f(C-B,D-C);}return w/=6.;}void main(){vec3 E=normalize(vec3(0,-1,-1));dc=distance(vec2(.5),texCoord);vec3 F=pos+vec3(.0,e(texCoord)*5.+dc*sin(elapsed),.0);vec3 G=normalize((transpose(inverse(modelView))*vec4(h(pos,texCoord),1.)).xyz);lightIntensity=dot(G,-E);gl_Position=projection*modelView*vec4(F,1.);}